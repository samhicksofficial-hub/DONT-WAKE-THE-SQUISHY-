# Built place/model files (generated from source, don't commit)
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# EXCEPT the real place file: it holds hand-imported models and the
# hand-edited map, which are irreplaceable rather than generated.
# Save it here via File -> Save to File As in Studio.
!place/*.rbxl
!place/*.rbxlx

# EXCEPT the Assets/ models: these are SOURCE, not build output. Rojo syncs
# them into the place (see default.project.json), so the game cannot be built
# without them: the Essential UI Pack UI and the imported squishy meshes.
# Regenerate with the scripts in tools/.
!Assets/*.rbxm

# Rojo build/session locks
*.lock

# Editor
.vscode/
.DS_Store
